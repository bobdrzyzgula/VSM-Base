(text "LINE SIDE: LIVE, 120 V" (at 345.44 111.3 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid 53d9d564-30f4-4192-88c2-d30d5e6600ee))
(text "CONTROL SIDE: isolated, SELV (3.3 V / 5 V)" (at 345.44 120.3 0) (effects (font (size 2.0 2.0) bold) (justify left bottom)) (uuid 93a51489-1ca2-4344-a269-d5db3519b789))
(text "ISOLATION BARRIER: U3, K1, U2, PS1 (and T1) straddle it; keep at least 6 mm creepage across it" (at 20.32 112.8 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 5c410275-155e-4675-93b5-87f55b14d7e6))
(text "MAINS IN, FUSE, SURGE; OUTLET (LIGHT always on, MOTOR controlled)" (at 20.32 38.1 0) (effects (font (size 1.5 1.5) bold) (justify left bottom)) (uuid 5a6e6516-ffda-4ae0-8979-44081049899c))
(text "TRIAC STAGE (after AN1662: triac in series with the motor)" (at 134.62 68.58 0) (effects (font (size 1.5 1.5) bold) (justify left bottom)) (uuid 967b4044-c007-4513-a18d-dd677bf881a4))
